# Copy to `.env` and fill in to override the built-in Firebase project config.
# These are public client identifiers (NOT secrets). Never commit server-only
# secrets such as service account keys to this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Local testing only (never enable in production) ---
# Connect the app to local Firebase Auth/Database emulators.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_DB_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_DB_EMULATOR_PORT=9000
